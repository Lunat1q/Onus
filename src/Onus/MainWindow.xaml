<Window x:Class="Onus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Onus.Views"
        Title="Onus" Width="1320" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource Body}" FontSize="13.5"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentGradient}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" Foreground="White" FontSize="18" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Onus" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="your Suno studio" Style="{StaticResource Muted}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Account -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" CornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource FaintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" Text="Suno" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Text="{Binding AccountText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <Button Margin="0,10,0,0" Style="{StaticResource AccentButton}" Padding="12,6" Content="Sign in"
                                Command="{Binding SignInCommand}"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent"
                         BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Width="20" />
                                <TextBlock Margin="12,0,0,0" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Margin="36,30,36,0" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Lyrics / now playing panel -->
        <Border Grid.Column="2" Width="340" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1,0,0,0" Visibility="{Binding LyricsVisible, Converter={StaticResource Visible}}">
            <DockPanel Margin="24,24,20,16" DataContext="{Binding Player}">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close"
                            Command="{Binding DataContext.ToggleLyricsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="Now playing" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,18,0,0" Height="292">
                    <Border CornerRadius="14" Background="{StaticResource ArtPlaceholder}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="54" Foreground="#80FFFFFF" />
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Current.Art, Converter={StaticResource Img}, ConverterParameter=600}" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,14">
                    <TextBlock Text="{Binding Current.Title, FallbackValue='Nothing playing'}" FontFamily="{StaticResource Display}"
                               FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Current.Artist}" Style="{StaticResource Muted}" FontSize="13.5" Margin="0,2,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Text="{Binding Current.Lyrics}" TextWrapping="Wrap" FontSize="14.5" LineHeight="25"
                                   Foreground="{StaticResource SubtleBrush}" />
                        <TextBlock Text="No lyrics for this song." Style="{StaticResource Muted}"
                                   Visibility="{Binding Current.Lyrics, Converter={StaticResource Visible}, ConverterParameter=not, FallbackValue=Visible}" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <v:AnalyzerPanel Grid.Row="1" Grid.ColumnSpan="3"
                         Visibility="{Binding AnalyzerVisible, Converter={StaticResource Visible}}" />
        <v:PlayerBar Grid.Row="2" Grid.ColumnSpan="3" DataContext="{Binding Player}" />

        <!-- Toast -->
        <Border Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0"
                Background="#F02A2A38" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="20"
                Padding="18,10" IsHitTestVisible="False"
                Visibility="{Binding Toast, Converter={StaticResource Visible}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" FontSize="14" />
                <TextBlock Margin="10,0,0,0" Text="{Binding Toast}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
