<Window x:Class="Onus.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onus" Width="440" Height="92" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource Body}" Foreground="{StaticResource TextBrush}"
        MouseLeftButtonDown="OnDrag">
    <Border Background="{StaticResource PlayerBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="16" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid Margin="10,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="56" Height="56" VerticalAlignment="Center">
                <Border CornerRadius="10" Background="{StaticResource ArtPlaceholder}" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Current.Art, Converter={StaticResource Img}, ConverterParameter=112}" />
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Current.Title, FallbackValue='Nothing playing'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Current.Artist}" Style="{StaticResource Muted}" />
                <ProgressBar Height="3" Margin="0,8,0,0" Maximum="{Binding SeekMax}" Value="{Binding Position, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" Foreground="{StaticResource TextBrush}" />
                <Button Margin="4,0" Command="{Binding TogglePlayCommand}" Width="36" Height="36">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                            <Setter Property="Content" Value="&#xF5B0;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="&#xF8AE;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" Foreground="{StaticResource TextBrush}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Back to full window" Click="OnExpand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
