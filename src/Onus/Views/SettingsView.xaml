<UserControl x:Class="Onus.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Hint2" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Changes save automatically." Style="{StaticResource Muted}" Margin="0,2,0,22" />

            <!-- Account -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Suno account" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Sign in" Command="{Binding SignInCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SubtleButton}" Content="Sign out" Command="{Binding SignOutCommand}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.AccountText, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint2}"
                                       Text="Onus signs in through a built-in Edge window and keeps the session fresh on its own — no browser extension, no copying tokens every minute." />
                        </StackPanel>
                    </DockPanel>
                    <Expander Header="Trouble signing in?" Margin="0,14,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Hint2}"
                                       Text="If the sign-in window refuses your login method, sign in on suno.com in your normal browser, open DevTools (F12) → Application → Cookies → https://suno.com, and copy the value of the __client cookie (it may sit under auth.suno.com or clerk.suno.com)." />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Use cookie" Margin="10,0,0,0"
                                        Command="{Binding ImportCookieCommand}" />
                                <TextBox Text="{Binding Cookie, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="Manual bearer token (advanced — expires after about a minute)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Settings.ManualToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Downloads -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Downloads" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Library folder" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Browse…" Margin="10,0,0,0" Command="{Binding BrowseCommand}" />
                        <TextBox Text="{Binding Settings.DownloadFolder}" IsReadOnly="True" />
                    </DockPanel>
                    <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="fmt" Content="MP3 · compact"
                                     IsChecked="{Binding Settings.Format, Converter={StaticResource Match}, ConverterParameter=Mp3}" />
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="fmt" Content="WAV · lossless"
                                     IsChecked="{Binding Settings.Format, Converter={StaticResource Match}, ConverterParameter=Wav}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint2}" Margin="0,0,0,8" Text="WAV asks Suno to render the file first, so it is slower. Falls back to MP3 if it fails." />
                    <CheckBox Content="Embed title, artist, style, lyrics and cover art in the file" IsChecked="{Binding Settings.EmbedMetadata}" />
                    <CheckBox Content="Save lyrics next to each song (.txt)" IsChecked="{Binding Settings.SaveLyricsFile}" />
                    <CheckBox Content="Save cover art files (song.jpg + cover.jpg for Explorer)" IsChecked="{Binding Settings.SaveArtFiles}" />
                    <CheckBox Content="Sort into month folders (2026-11)" IsChecked="{Binding Settings.OrganizeByMonth}" />
                    <CheckBox Content="Put workspace / playlist downloads in their own folder" IsChecked="{Binding Settings.PlaylistSubfolder}" />
                    <CheckBox Content="Group stems in a folder named after the song" IsChecked="{Binding Settings.StemsInTrackFolder}" />
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Scanning" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Start page" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Settings.StartPage, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Max pages (0 = all)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Settings.MaxPages, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Delay between files (s)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Settings.DownloadDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Parallel downloads" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Settings.ParallelDownloads, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <CheckBox Margin="0,14,0,0" Content="Smart Resume for Sync" IsChecked="{Binding Settings.SmartResume}" />
                    <TextBlock Style="{StaticResource Hint2}"
                               Text="Once Sync has found new songs, it stops after a run of pages with nothing new (2–20 pages, scaled to your library size) instead of walking your whole history." />
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Style="{StaticResource SubtleButton}" Content="Import from SunoSync" Command="{Binding ImportSunoSyncCommand}" Margin="0,0,10,8"
                                ToolTip="Download folder, Prompt Vault and keep/star/trash marks" />
                        <Button Style="{StaticResource SubtleButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="Open log" Command="{Binding OpenLogCommand}" Margin="0,0,10,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint2}" Text="Onus 1.0 — a native Windows rework of SunoSync. Not affiliated with Suno." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
