<UserControl x:Class="Onus.Views.AnalyzerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Onus.Views"
             Height="250" ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="CardHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PlayerBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
            Padding="18,12,6,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="262" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="176" />
            </Grid.ColumnDefinitions>

            <!-- Levels & loudness -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LEVELS · LOUDNESS" Style="{StaticResource CardHead}" />
                    <v:Scope x:Name="Meter" Width="64" DockPanel.Dock="Left" />
                    <StackPanel Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ShortTerm" Text="—" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text=" LUFS" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                        <TextBlock Text="short-term (3 s)" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                        <TextBlock x:Name="LoudStats" Style="{StaticResource Num}" LineHeight="18"
                                   ToolTip="Momentary = 400 ms, integrated = this song so far (BS.1770 gated). PLR = peak to loudness ratio. Target = vs. the −14 LUFS most streaming services normalise to. Onus divides its volume slider (and Suno's page volume) back out, so these describe the song itself." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Spectrum + spectrogram -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="Brightness" DockPanel.Dock="Right" Style="{StaticResource Num}" FontSize="11"
                                   ToolTip="Spectral centroid: where the energy sits on average (higher = brighter)" />
                        <TextBlock x:Name="Capture" DockPanel.Dock="Right" Style="{StaticResource Num}" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{StaticResource DangerBrush}"
                                   ToolTip="Capturing this stream-only song for the analytics cache. Play it through from the start without seeking; once complete it plays from the copy." />
                        <TextBlock Text="SPECTRUM" Style="{StaticResource CardHead}" />
                    </DockPanel>
                    <Image x:Name="Spectrogram" DockPanel.Dock="Bottom" Height="48" Stretch="Fill" Margin="0,6,0,0"
                           RenderOptions.BitmapScalingMode="Linear" ToolTip="Spectrogram: last ~10 s, low notes at the bottom" />
                    <v:Scope x:Name="Spectrum" ToolTip="Dashed lines: harmonics of the detected fundamental" />
                </DockPanel>
            </Border>

            <!-- Pitch, harmonics, chroma, key -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HARMONY" Style="{StaticResource CardHead}" />
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="PitchHz" DockPanel.Dock="Right" Style="{StaticResource Num}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        <TextBlock x:Name="Pitch" Text="—" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold"
                                   ToolTip="Dominant fundamental (harmonic product spectrum) and its offset from equal temperament" />
                    </DockPanel>
                    <TextBlock x:Name="Key" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,6"
                               ToolTip="Key estimate from ~8 s of pitch-class energy (Krumhansl–Schmuckler); % = profile correlation" />
                    <TextBlock DockPanel.Dock="Top" Text="Harmonics H1–H8 (dB vs. fundamental)" Style="{StaticResource Muted}" FontSize="10.5" />
                    <v:Scope x:Name="Partials" DockPanel.Dock="Top" Height="40" Margin="0,2,0,6" />
                    <v:Scope x:Name="Chroma" ToolTip="Pitch-class energy right now; the estimated key's tonic is highlighted" />
                </DockPanel>
            </Border>

            <!-- Chords & mood -->
            <Border Grid.Column="3" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="CHORDS · MOOD" Style="{StaticResource CardHead}" />
                    <TextBlock x:Name="Chord" Text="—" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold"
                               ToolTip="Major or minor triad sounding now (~0.5 s of pitch-class energy, held 0.3 s before it counts)" />
                    <TextBlock x:Name="Mood" Text="listening…" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,6"
                               ToolTip="Mood after 15 s of chords: major vs. minor share of chord time (happy ↔ sad) × energy (loudness + brightness). A rough guide, not a verdict." />
                    <v:Scope x:Name="MajorMinor" Height="14" Margin="0,0,0,6"
                             ToolTip="Share of this song's chord time in major (gold) vs. minor (purple) chords" />
                    <TextBlock x:Name="MoodStats" Style="{StaticResource Num}" FontSize="11" LineHeight="17"
                               ToolTip="Chords = most played this song. Changes = chord changes per minute (harmonic rhythm). Energy = integrated loudness and average brightness." />
                </StackPanel>
            </Border>

            <!-- Stereo -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="STEREO" Style="{StaticResource CardHead}" />
                    <TextBlock x:Name="StereoStats" DockPanel.Dock="Bottom" Style="{StaticResource Num}" FontSize="11" Margin="0,4,0,0"
                               ToolTip="Correlation: +1 mono, 0 wide, below 0 phase problems (cancels in mono). Width = side vs. mid energy." />
                    <v:Scope x:Name="Correlation" DockPanel.Dock="Bottom" Height="14" Margin="0,6,0,0" />
                    <v:Scope x:Name="Vector" ToolTip="Goniometer: vertical = mono, horizontal = side, wider cloud = wider stereo" />
                </DockPanel>
            </Border>

            <TextBlock x:Name="Status" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Padding="16,8" Background="#E015151D" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="560" />
        </Grid>
    </Border>
</UserControl>
