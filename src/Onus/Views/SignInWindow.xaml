<Window x:Class="Onus.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Suno" Width="1040" Height="780" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource Body}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentGradient}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" Foreground="White" FontSize="14" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Sign in with any method Suno offers" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"
                               Text="This window closes by itself once you're signed in. Onus never sees your password." />
                </StackPanel>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0E0E13" />
    </DockPanel>
</Window>
