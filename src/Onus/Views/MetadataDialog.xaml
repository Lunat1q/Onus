<Window x:Class="Onus.Views.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit details" Width="560" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource Body}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SubtleButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Style="{StaticResource AccentButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="FileText" Style="{StaticResource Muted}" Margin="0,12,0,0" />
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="TitleBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Artist" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="ArtistBox" />
            </StackPanel>
        </Grid>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Style / genre" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="GenreBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="BPM" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="BpmBox" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="Lyrics" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LyricsBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
    </DockPanel>
</Window>
