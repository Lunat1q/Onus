<UserControl x:Class="Onus.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Player mark buttons light up in their colour when the current song has that mark. -->
        <Style x:Key="MarkButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Command" Value="{Binding ToggleTagCommand}" />
        </Style>
        <Style x:Key="ToggleIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PlayerBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
            Height="94" Padding="18,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Now playing -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="58" Height="58">
                    <Border CornerRadius="9" Background="{StaticResource ArtPlaceholder}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="20" Foreground="#80FFFFFF" />
                    </Border>
                    <Border CornerRadius="9">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Current.Art, Converter={StaticResource Img}, ConverterParameter=120}" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="230">
                    <TextBlock Text="{Binding Current.Title, FallbackValue='Nothing playing'}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="6,1" Margin="0,0,6,0"
                                Visibility="{Binding Current.IsStream, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                            <TextBlock Text="STREAM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Current.Artist, FallbackValue='Pick a song to start'}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Current, Converter={StaticResource Visible}}">
                    <Button Content="&#xE8E1;" ToolTip="Keep" CommandParameter="keep">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTag}" Value="keep">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button ToolTip="Star" CommandParameter="star">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MarkButton}">
                                <Setter Property="Content" Value="&#xE734;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTag}" Value="star">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="Content" Value="&#xE735;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE74D;" ToolTip="Trash" CommandParameter="trash">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTag}" Value="trash">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Transport -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="560">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&#xE8B1;" ToolTip="Shuffle" Command="{Binding ToggleShuffleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToggleIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Shuffle}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="10,0,0,0" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (Ctrl+←)"
                            Command="{Binding PreviousCommand}" Foreground="{StaticResource TextBrush}" />
                    <Button Margin="10,0" Command="{Binding TogglePlayCommand}" ToolTip="Play / pause (Space)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                <Setter Property="Content" Value="&#xF5B0;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="&#xF8AE;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (Ctrl+→)"
                            Command="{Binding NextCommand}" Foreground="{StaticResource TextBrush}" />
                    <Button Margin="10,0,0,0" Command="{Binding CycleRepeatCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToggleIcon}">
                                <Setter Property="Content" Value="&#xE8EE;" />
                                <Setter Property="ToolTip" Value="Repeat: off" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Repeat}" Value="All">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="ToolTip" Value="Repeat: all" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Repeat}" Value="One">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Content" Value="&#xE8ED;" />
                                        <Setter Property="ToolTip" Value="Repeat: this song" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Position, Converter={StaticResource Time}}" Style="{StaticResource Muted}"
                               FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="Seek" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="{Binding SeekMax}"
                            IsEnabled="{Binding Current, Converter={StaticResource HasValue}}"
                            Value="{Binding Position, Mode=OneWay}" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" Focusable="False" />
                    <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={StaticResource Time}}" Style="{StaticResource Muted}"
                               FontSize="11.5" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Extras -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar Width="18" Height="18" IsIndeterminate="True" Margin="0,0,8,0" Style="{x:Null}"
                             Visibility="{Binding IsBuffering, Converter={StaticResource Visible}}" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource AccentBrush}" />
                <Button Content="&#xE9D2;" ToolTip="Live analysis (A)"
                        Command="{Binding DataContext.ToggleAnalyzerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.AnalyzerVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="Now playing &amp; lyrics"
                        Command="{Binding DataContext.ToggleLyricsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Mini player" Click="OnMini" />
                <TextBlock Margin="10,0,4,0" Style="{StaticResource Glyph}" Text="&#xE767;" Foreground="{StaticResource SubtleBrush}" />
                <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" Focusable="False" ToolTip="Volume" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
