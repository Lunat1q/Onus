<UserControl x:Class="Onus.Views.CloudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Margin="0,0,10,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="12" />
                        <TextBlock Text="Stop" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding FetchCommand}" Margin="0,0,10,0"
                        ToolTip="List every song in the source without downloading">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="13" />
                        <TextBlock Text="Fetch" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding DownloadSelectedCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" />
                        <TextBlock Text="Download selected" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Command="{Binding SyncCommand}"
                        ToolTip="Scan and download everything that isn't on disk yet">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="13" />
                        <TextBlock Text="Sync new" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Suno" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Counts}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Source + search + filters toggle -->
        <DockPanel Grid.Row="1" Margin="0,22,0,0">
            <ToggleButton x:Name="FiltersToggle" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" />
                    <TextBlock Text="Filters" Margin="6,0,0,0" />
                </StackPanel>
            </ToggleButton>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="300" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE72C;" VerticalAlignment="Center"
                        ToolTip="Load my workspaces and playlists" Command="{Binding LoadSourcesCommand}" />
                <!-- Search all of Suno: server-side term + sort, Enter fetches -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsSearch, Converter={StaticResource Visible}}">
                    <Grid Width="260">
                        <TextBox x:Name="SunoSearchBox" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6"
                                 ToolTip="Search public songs on Suno. Leave empty to browse all of them. Enter to search.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0"
                                   Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" />
                        <TextBlock Style="{StaticResource Hint}" Margin="34,0,0,0" Text="Search Suno…" Tag="{Binding Text, ElementName=SunoSearchBox}" />
                    </Grid>
                    <ComboBox Width="150" Margin="6,0,0,0" ItemsSource="{Binding SearchRanks}" SelectedItem="{Binding SearchRank}"
                              ToolTip="Sort order" />
                </StackPanel>
                <Grid Width="280" Margin="14,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsSearch, Converter={StaticResource Visible}, ConverterParameter=not}">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Padding="34,6,10,6" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0"
                               Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource Hint}" Margin="34,0,0,0" Text="Filter by title, style, lyrics…" Tag="{Binding Text, ElementName=SearchBox}" />
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14,18,8"
                Visibility="{Binding IsChecked, ElementName=FiltersToggle, Converter={StaticResource Visible}}">
            <StackPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Chip}" Content="Liked only" IsChecked="{Binding LikedOnly}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Hide disliked" IsChecked="{Binding HideDisliked}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Hide stems" IsChecked="{Binding HideStems}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Stems only" IsChecked="{Binding StemsOnly}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Hide studio clips" IsChecked="{Binding HideStudioClips}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Public only" IsChecked="{Binding PublicOnly}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Include trash" IsChecked="{Binding IncludeTrashed}" />
                    <Rectangle Width="1" Height="22" Fill="{StaticResource StrokeBrush}" Margin="4,0,12,8" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" Content="All types"
                                 IsChecked="{Binding Kind, Converter={StaticResource Match}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" Content="Generations"
                                 IsChecked="{Binding Kind, Converter={StaticResource Match}, ConverterParameter=Generations}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" Content="Uploads"
                                 IsChecked="{Binding Kind, Converter={StaticResource Match}, ConverterParameter=Uploads}" />
                </WrapPanel>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Styles to include" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding TagsInclude, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Comma separated, e.g. synthwave, lofi" />
                    <TextBlock Grid.Column="2" Text="Exclude" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,10,0" />
                    <TextBox Grid.Column="3" Text="{Binding TagsExclude, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Comma separated" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status -->
        <DockPanel Grid.Row="3" Margin="0,16,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButton}" Padding="12,4" FontWeight="Normal" Content="Select new" Command="{Binding SelectNewCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource SubtleButton}" Padding="12,4" FontWeight="Normal" Content="Clear" Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Left" Width="16" Height="16" IsIndeterminate="True" Margin="0,0,10,0" Style="{x:Null}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>

        <ListView Grid.Row="4" Style="{StaticResource SongList}" ItemsSource="{Binding Clips}" SelectionMode="Single"
                  MouseDoubleClick="OnDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" />
                        <Grid Grid.Column="1" Width="48" Height="48" HorizontalAlignment="Left">
                            <Border CornerRadius="8" Background="{StaticResource ArtPlaceholder}" />
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Art, Converter={StaticResource Img}, ConverterParameter=96}" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="8" Background="#99000000" Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE995;" Foreground="White" />
                            </Border>
                            <Button Style="{StaticResource IconButton}" Width="48" Height="48" Content="&#xF5B0;" Foreground="White"
                                    Background="Transparent" ToolTip="Play" Opacity="0.0" x:Name="PlayOverlay"
                                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB52;" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{StaticResource Accent2Brush}"
                                           Visibility="{Binding IsLiked, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Created}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Grid Grid.Column="5" VerticalAlignment="Center">
                            <ProgressBar Height="4" Maximum="1" Value="{Binding Progress}" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" />
                            <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" ToolTip="{Binding Error}"
                                    Visibility="{Binding IsWorking, Converter={StaticResource Visible}, ConverterParameter=not}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OnDisk}" Value="True">
                                                <Setter Property="Background" Value="#2622C55E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                <Setter Property="Background" Value="#33F43F5E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                            <Setter TargetName="PlayOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="PlayOverlay" Property="Background" Value="#80000000" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding Clips.Count, Converter={StaticResource Visible}, ConverterParameter=not}">
            <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE753;" FontSize="28" Foreground="White" />
            </Border>
            <TextBlock Margin="0,18,0,6" Text="Your songs on Suno" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}"
                       Text="Fetch lists everything in the source so you can stream it right here. Sync new downloads only what isn't on disk yet." />
            <Button Style="{StaticResource AccentButton}" Content="Sign in to Suno" HorizontalAlignment="Center" Margin="0,18,0,0"
                    Command="{Binding DataContext.SignInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}, ConverterParameter=not}" />
        </StackPanel>

        <!-- Activity log -->
        <Expander Grid.Row="5" Margin="0,8,0,10" Header="Activity">
            <ListBox ItemsSource="{Binding Activity}" Height="150" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource FaintBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Message}" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
    </Grid>
</UserControl>
