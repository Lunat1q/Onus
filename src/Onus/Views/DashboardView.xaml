<UserControl x:Class="Onus.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButton}" Margin="0,0,10,0" Content="Open library"
                            Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Library" />
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding DataContext.SyncNowCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="13" />
                            <TextBlock Text="Sync new songs" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Here's what's in your studio." Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="-8,26,-8,0">
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}" Background="{StaticResource AccentGradient}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding TrackCount}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Songs on disk" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}" Background="#2E3B82F6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" Foreground="#60A5FA" />
                        </Border>
                        <TextBlock Text="{Binding TotalTime}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Total listening time" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}" Background="#2622C55E">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Foreground="#4ADE80" />
                        </Border>
                        <TextBlock Text="{Binding Storage}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Storage used" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}" Background="#33EAB308">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" Foreground="#FACC15" />
                        </Border>
                        <TextBlock Text="{Binding TopGenre}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Top style" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Top styles" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Genres}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <Grid Height="6" Margin="0,7,0,0">
                                            <Border CornerRadius="3" Background="{StaticResource StrokeBrush}" />
                                            <Border CornerRadius="3" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Fraction}" />
                                                </Border.RenderTransform>
                                                <Border.Width>
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Styles show up once you have some songs." Style="{StaticResource Muted}"
                                   Visibility="{Binding Genres.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recently added" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Library.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" Margin="-8,0,-8,2">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="8,6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                                <Border CornerRadius="7" Background="{StaticResource ArtPlaceholder}" />
                                                <Border CornerRadius="7">
                                                    <Border.Background>
                                                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ArtPath, Converter={StaticResource Img}, ConverterParameter=80}" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Genre}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nothing yet — press Sync new songs to pull your Suno library." Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Visibility="{Binding Recent.Count, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
